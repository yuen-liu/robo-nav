 THIRD_PERSON_CAMERA_NAME = "robot_third_person"
 WHEEL_RADIUS = 0.033
 WHEEL_TRACK = 0.160
+# Kinematic stepping teleports the base, so contacts never push back on their own. Instead a
+# step that drives the chassis deeper into scene geometry is rejected (or reduced to a slide
+# along one axis), which makes walls and furniture block the robot.
+PENETRATION_TOLERANCE = 2e-3
 
 
 def _robot_body() -> ET.Element:
@@ -83,9 +87,26 @@ class TurtleBotBackend:
         self._right_qpos = self.model.jnt_qposadr[self._right_joint]
         self._left_dof = self.model.jnt_dofadr[self._left_joint]
         self._right_dof = self.model.jnt_dofadr[self._right_joint]
+        self._chassis_geom = self.model.geom("base_collision").id
         self._yaw = 0.0
         mujoco.mj_forward(self.model, self.data)
 
+    def _penetration(self) -> float:
+        """Deepest overlap (m) between the chassis cylinder and anything else, after mj_forward."""
+        depth = 0.0
+        for i in range(self.data.ncon):
+            contact = self.data.contact[i]
+            if self._chassis_geom in (contact.geom1, contact.geom2):
+                depth = max(depth, -float(contact.dist))
+        return depth
+
+    def _blocked(self, before: float) -> bool:
+        mujoco.mj_forward(self.model, self.data)
+        # Never deeper than the tolerance; if already deeper (e.g. spawned overlapping), only allow
+        # moves that do not increase it -- a relative tolerance would let the robot creep in.
+        after = self._penetration()
+        return after > PENETRATION_TOLERANCE and after > before
+
     def reset(self) -> None:
         mujoco.mj_resetData(self.model, self.data)
         self._yaw = 0.0
